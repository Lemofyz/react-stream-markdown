{
  "name": "stream-readable",
  "version": "0.3.0",
  "description": "Render streaming AI replies as Markdown while they are still being written. React, zero dependencies.",
  "keywords": [
    "streaming",
    "markdown",
    "llm",
    "ai",
    "chat",
    "react",
    "sse",
    "openai",
    "claude",
    "typewriter"
  ],
  "homepage": "https://lemofyz.github.io/stream-readable/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemofyz/stream-readable.git"
  },
  "bugs": "https://github.com/Lemofyz/stream-readable/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "lib",
    "src/style.css",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "prepublishOnly": "npm test && npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
