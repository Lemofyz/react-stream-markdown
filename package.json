{
  "name": "stream-readable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Measure and display streaming text without sentence buffering.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "lib",
    "src/style.css",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
